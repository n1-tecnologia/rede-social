# apps/api environment template (the API and the worker run the same image; ROLE picks the process).
# Generate the real local file from the running stack instead of copying this one:
#   pnpm supabase start && bash scripts/local-env.sh --write
# Validated at boot by `packages/core/server/env.ts` (`assertProductionEnv` refuses a half-configured
# provider in production). Never commit real values: production values live ONLY in GCP Secret
# Manager and are mounted by `.github/workflows/deploy-api.yml` (docs/DEPLOY.md).

# ── Core ─────────────────────────────────────────────────────────────────────
# `api` serves HTTP on PORT; `worker` runs the pg-boss jobs (a health listener on PORT).
ROLE=api
PORT=8787
LOG_LEVEL=info
# The api_user connection (local: direct port 54322; production: the transaction pooler, 6543).
DATABASE_URL=postgres://api_user:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=
PLATFORM_HOST=rede-social.localhost

# ── Custom domains (D-34): the fail-safe local adapters ──────────────────────
DOMAIN_PROVIDER=fake
AUTH_ALLOW_LIST=local

# ── Video (MEDIA-03): the fake provider; Mux only in production ──────────────
VIDEO_PROVIDER=fake

# ── Mail: Mailpit locally, Resend in production ──────────────────────────────
MAIL_TRANSPORT=local
SEND_EMAIL_HOOK_SECRETS=

# ── Web Push (07-06, NOTIF-03) ───────────────────────────────────────────────
# `fake` records the send and never reaches FCM, Mozilla, Apple or WNS; it is the only transport any
# local or CI run uses. Production runs `webpush` with its own VAPID pair, whose three values exist
# ONLY in Secret Manager (vapid-public-key-prod, vapid-private-key-prod, vapid-subject-prod). Leave
# the three below empty here: a real private key never belongs in a file.
PUSH_TRANSPORT=fake
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Seed and integration tests (local stack only) ────────────────────────────
SEED_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
