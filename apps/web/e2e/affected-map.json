    {
      "id": "feed-web",
      "why": "The feed surfaces: the home feed, the post detail and the composer routes, and the components and helpers that render posts; the feed, comment, composer, media and share specs drive them, comunidades and moderation render and act on the same posts, and the CSP walk opens a post.",
      "globs": [
        "apps/web/components/feed/**",
        "apps/web/lib/feed*",
        "apps/web/app/(app)/{inicio,post,criar}/**"
      ],
      "specs": [
        "feed.spec.ts",
        "feed-comments.spec.ts",
        "feed-composer.spec.ts",
        "feed-media.spec.ts",
        "feed-share.spec.ts",
        "phase4-smoke.spec.ts",
        "comunidades.spec.ts",
        "moderation.spec.ts",
        "phase8-smoke.spec.ts",
        "csp.spec.ts"
      ]
    },
    {
      "id": "feed-module",
      "why": "The feed module (posts, comments, likes, link previews) is also read through raw SQL by stories, reels and the notification fan-out, so a change here can break their specs as well as the feed ones.",
      "globs": ["packages/modules/feed/**"],
      "specs": [
        "feed.spec.ts",
        "feed-comments.spec.ts",
        "feed-composer.spec.ts",
        "feed-media.spec.ts",
        "feed-share.spec.ts",
        "phase4-smoke.spec.ts",
        "comunidades.spec.ts",
        "moderation.spec.ts",
        "phase8-smoke.spec.ts",
        "csp.spec.ts",
        "notifications.spec.ts",
        "reels.spec.ts",
        "stories.spec.ts",
        "phase52-smoke.spec.ts",
        "phase5-smoke.spec.ts",
        "phase7-smoke.spec.ts"
      ]
    },
    {
      "id": "catalog-feed",
      "why": "Every spec that imports messages/pt-BR/feed.json asserts on its strings, together with the specs of the feed surfaces themselves.",
