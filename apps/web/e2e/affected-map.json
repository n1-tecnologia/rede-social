        "phase7-smoke.spec.ts",
        "branding.spec.ts",
        "phase2-smoke.spec.ts",
        "shell.spec.ts"
      ]
    },
    {
      "id": "catalog-pwa",
      "why": "phase7-smoke and push.spec import messages/pt-BR/pwa.json and assert on its strings, together with the pwa specs.",
      "globs": ["apps/web/messages/pt-BR/pwa.json"],
      "specs": [
        "pwa.spec.ts",
        "push.spec.ts",
        "phase7-smoke.spec.ts",
        "branding.spec.ts",
        "phase2-smoke.spec.ts",
        "shell.spec.ts"
