# apps/web environment template. Copy to `.env.local`, or generate it from the running local stack:
#   pnpm supabase start && bash scripts/local-env.sh > apps/web/.env.local
# Validated at import time by `lib/env.ts` (fail fast at build and at runtime). Never commit real keys.

# ── App (lib/env.ts) ─────────────────────────────────────────────────────────
# Base URL of the Hono API the web BFF calls (Cloud Run in staging/production).
API_URL=http://localhost:8787
# Hostname reserved for the platform's `super_admin` entry (D-21). Production: the platform domain
# (e.g. app.seusistema.com). Leave UNSET on Vercel Preview so every preview host stays generic.
PLATFORM_HOST=rede-social.localhost
# Content Security Policy header (08-08): `report-only` (default when unset; production ships this
# first) or `enforce`. The Playwright harness always runs `enforce`.
# CSP_MODE=report-only
# Public values, inlined into the client bundle at build time. Only the publishable key — never the service key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Web Push (07-07): the PUBLIC half of the worker's VAPID pair. Optional — when unset every push
# surface shows "Este navegador não recebe notificações.". This value is a LOCAL-ONLY TEST key (its
# private half was discarded; local push runs PUSH_TRANSPORT=fake). Production uses its own pair
# (DEPLOY.md: vapid-public-key-prod on Vercel as NEXT_PUBLIC_VAPID_PUBLIC_KEY). Never put a private key here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BJHs89NeHI8M9hJQWfvb1_irumrdO-cNFTwQZUHrWx3Lp3smi-NAifeRu5Pm4rWfwmQCL5GvEdK8_PVtNafxV1k
# Optional: version label shown in Configurações. Falls back to VERCEL_GIT_COMMIT_SHA, then "dev".
# NEXT_PUBLIC_APP_VERSION=

# ── E2E only (Playwright loads this file; not read by the Next.js app) ──────
# Seed credentials used by the login fixtures (same values as the root .env for `pnpm db:seed`).
SEED_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Server-side admin access for the signup spec. Local stack only — never a hosted project's key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=

# Optional overrides; the defaults below match the local stack.
# PLAYWRIGHT_BASE_URL=            # set to run against a remote deployment (e.g. a Vercel preview)
# PLAYWRIGHT_DEMO_URL=http://rede-demo.localhost:3000
# PLAYWRIGHT_LAB_URL=http://rede-lab.localhost:3000
# PLAYWRIGHT_PLATFORM_URL=http://rede-social.localhost:3000
# PLAYWRIGHT_GENERIC_URL=http://localhost:3000
# PLAYWRIGHT_API_URL=http://127.0.0.1:8787
# PLAYWRIGHT_DB_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# PLAYWRIGHT_MAIL_URL=http://127.0.0.1:54324
# PLAYWRIGHT_REPORT_DIR=playwright-report
# PLAYWRIGHT_OUTPUT_DIR=test-results
# PWA_PROD=1                      # runs the production-build PWA specs
