{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["CI", "NODE_ENV"],
  // Spike-only inputs (`pnpm spike:supavisor`, plan 01-03/01-12). They never feed a turbo task, so
  // they are passed through instead of hashed; declaring them keeps Biome's noUndeclaredEnvVars quiet.
  "globalPassThroughEnv": ["SPIKE_*", "TENANT_A", "TENANT_B", "SEED_PASSWORD"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "API_URL", "DATABASE_URL", "SUPABASE_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "env": ["NEXT_PUBLIC_*", "API_URL", "DATABASE_URL", "SUPABASE_*"]
    },
    "test:integration": {
      "cache": false,
      "env": [
        "NEXT_PUBLIC_*",
        "API_URL",
        "DATABASE_URL",
        "SUPABASE_*",
        "SEED_PASSWORD",
        "TENANT_*",
        "PLATFORM_HOST"
      ]
    },
    "e2e": {
      "cache": false,
      "env": [
        "NEXT_PUBLIC_*",
        "API_URL",
        "DATABASE_URL",
        "SUPABASE_*",
        "SEED_PASSWORD",
        "TENANT_*",
        "PLATFORM_HOST"
      ]
    }
  },
  "boundaries": {
    "tags": {
      "module": {
        "dependencies": { "allow": ["kernel", "contracts", "tooling"] },
        "dependents": { "deny": ["module"] }
      },
      "kernel": {
        "dependencies": { "deny": ["module", "app"] }
      },
      "contracts": {
        "dependencies": { "allow": ["tooling"] }
      },
      "app": {
        "dependencies": { "allow": ["kernel", "contracts", "module", "tooling", "app"] }
      },
      "tooling": {
        "dependencies": { "allow": ["tooling"] }
      }
    }
  }
}
