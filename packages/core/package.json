{
  "name": "@rede-social/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kernel: database client, tenant/admin transaction lanes, core schema, auth and tenancy middleware, client-safe kernel UI (./ui)",
  "exports": {
    "./db": "./db/client.ts",
    "./db/schema": "./db/schema/index.ts",
    "./db/tenant-tx": "./db/tenant-tx.ts",
    "./db/admin-tx": "./db/admin-tx.ts",
    "./db/rls": "./db/rls.ts",
    "./server/*": "./server/*.ts",
    "./ui": "./ui/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@mux/mux-node": "15.2.0",
    "@supabase/supabase-js": "2.116.0",
    "@t3-oss/env-core": "0.13.11",
    "@rede-social/contracts": "workspace:*",
    "@rede-social/ui": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "lucide-react": "1.46.0",
    "pg-boss": "12.31.0",
    "pino": "10.3.1",
    "png-to-ico": "3.0.2",
    "postgres": "3.4.9",
    "resend": "6.28.0",
    "sharp": "0.35.4",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@rede-social/config": "workspace:*",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "next": "^16.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
