# ── Database ─────────────────────────────────────────────────────────────────
# API connection as the `api_user` role. Local: the Supabase CLI PgBouncer (transaction mode, port 54329).
# Development-only fallback if that pooler refuses `api_user`: postgres://api_user:postgres@127.0.0.1:54322/postgres (direct port).
DATABASE_URL=postgres://api_user:postgres@127.0.0.1:54329/postgres
# Direct connection used only by the Supavisor spike (scripts/spike-supavisor.test.ts); staging/production use the pooler URL.
SPIKE_DATABASE_URL=postgres://api_user:postgres@127.0.0.1:54329/postgres
# Password CI sets on `api_user` in hosted projects (the role is created without one by supabase/roles.sql).
API_DB_PASSWORD=

# ── Supabase (API only; the service key never reaches the browser) ───────────
# Local stack: http://127.0.0.1:54321 (run `bash scripts/local-env.sh` after `pnpm supabase start`).
SUPABASE_URL=http://127.0.0.1:54321
# Service (secret) key — server-side admin calls only.
SUPABASE_SERVICE_KEY=
# Publishable (anon) key — used by the API integration tests to mint a real user session.
SUPABASE_PUBLISHABLE_KEY=

# ── Web (public values inlined at build time) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base URL of the Hono API the web BFF calls.
API_URL=http://localhost:8787

# ── Hosts (D-20..D-24) ───────────────────────────────────────────────────────
# Web-only: hostname reserved for TRIA's `super_admin` entry (D-21). Production placeholder: app.seusistema.com.
PLATFORM_HOST=tria.localhost
# Seed tenants' hostnames registered in `tenant_domains` by `pnpm db:seed` (D-24).
# Renaming either value on an already-seeded database makes the seed demote that tenant's previous primary host to a
# non-primary alias and register the new value as the single primary row (tenant_domains_one_primary_per_tenant allows one
# primary per tenant; the old row is kept, not deleted). There is no SITE_URL: absolute URLs derive from the request origin (D-22).
TENANT_DEMO_HOST=tria-demo.localhost
TENANT_LAB_HOST=tria-lab.localhost

# ── API process ──────────────────────────────────────────────────────────────
PORT=8787
# api | worker — the worker runs from the same image (D-18).
ROLE=api
LOG_LEVEL=info

# ── Seed (scripts/seed.ts, D-14) — never commit real values ──────────────────
SEED_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Tenant ids used by the Supavisor spike (filled after the first seed).
TENANT_A=
TENANT_B=

# ── E-mail (plan 01-11: Resend as Supabase custom SMTP) ──────────────────────
RESEND_API_KEY=
