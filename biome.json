{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "root": true,
  "extends": [
    "./packages/config/biome.base.json"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!.gsd/**",
      "!.planning/**",
      "!.claude/**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/next-env.d.ts",
      "!**/.turbo",
      "!**/coverage",
      "!supabase/migrations",
      "!supabase/.temp",
      "!reference"
    ]
  },
  "overrides": [
    {
      "includes": [
        "**",
        "!packages/core/server/tenancy/**",
        "!packages/core/server/platform/**",
        "!scripts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@tria/core/db/admin-tx",
                      "@tria/core/server/supabase-admin"
                    ],
                    "message": "Admin lane is kernel-only"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/modules/**",
        "packages/boundary-fixture/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@tria/module-*/server/*",
                      "@tria/module-*/db/*",
                      "@tria/module-*/ui/*",
                      "@tria/module-*/contracts/*",
                      "@tria/module-*/src/**",
                      "@tria/core/src/**",
                      "../../../core/**"
                    ],
                    "message": "Import published entry points only"
                  },
                  {
                    "group": [
                      "@tria/core/db/admin-tx",
                      "@tria/core/server/supabase-admin"
                    ],
                    "message": "Admin lane is kernel-only"
                  },
                  {
                    "group": [
                      "@tria/core/db"
                    ],
                    "message": "A module reaches data only through withTenantTx (@tria/core/db/tenant-tx); the raw db/sqlClient could switch roles outside the lane guard"
                  },
                  {
                    "group": [
                      "@tria/api",
                      "@tria/api/*"
                    ],
                    "message": "A module may not import an app package"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@tria/core/db/*",
                      "@tria/core/server/*",
                      "@tria/api/*",
                      "!@tria/api/types"
                    ],
                    "message": "Web imports contracts, module ui and API types only"
                  },
                  {
                    "group": [
                      "@tria/core/db/admin-tx",
                      "@tria/core/server/supabase-admin"
                    ],
                    "message": "Admin lane is kernel-only"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/styles/tokens.css"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
